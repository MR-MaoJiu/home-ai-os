HOMEAI_DATABASE_URL=postgresql+psycopg://homeai:CHANGE_ME@127.0.0.1:5432/homeai
HOMEAI_STATE_DIR=./state
HOMEAI_OPA_URL=http://127.0.0.1:8181
HOMEAI_NATS_URL=nats://127.0.0.1:4222
HOMEAI_ENVIRONMENT=development
# 主密钥通过文件注入，不要提交实际密钥。
HOMEAI_MASTER_KEY_FILE=./state/master.key

# 管理页面构建目录；相对路径以启动进程的工作目录为基准。
HOMEAI_ADMIN_DIST=./admin-web/dist
