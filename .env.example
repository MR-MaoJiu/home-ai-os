HOMEAI_DATABASE_URL=postgresql+psycopg://homeai:CHANGE_ME@127.0.0.1:5432/homeai
HOMEAI_STATE_DIR=./state
HOMEAI_OPA_URL=http://127.0.0.1:8181
HOMEAI_NATS_URL=nats://127.0.0.1:4222
HOMEAI_ENVIRONMENT=development
# 主密钥通过文件注入，不要提交实际密钥。
HOMEAI_MASTER_KEY_FILE=./state/master.key

# 管理页面构建目录；相对路径以启动进程的工作目录为基准。
HOMEAI_ADMIN_DIST=./admin-web/dist

# 必须指向实际终止 HTTPS 的叶证书；换证书后同步更新并重新加载 HTTPS 服务。
HOMEAI_IDENTITY_CERTIFICATE_FILE=./state/tls/server.crt
# 可公开的访问地址列表，不包含用户信息或凭据。
HOMEAI_SERVER_ADDRESSES='["https://localhost:58443"]'

# 可选的受管 HTTPS 证书入口，与 P2P 数据通道独立。
HOMEAI_MANAGED_HTTPS_PORT=58448

# 不绑定平台时不会启动远程协商；仅允许 STUN，禁止 TURN。
HOMEAI_DIRECT_ENABLED=true
HOMEAI_DIRECT_STUN_URLS='[]'

# 可选 APNs 通知：自行编译 iOS App 的部署者使用自己 Apple 团队的密钥和 Bundle ID。
# .p8 放在服务器安全目录，chmod 600；禁止提交仓库或下发给手机/其他自托管用户。
# 未配置时服务端仍生成持久通知箱；不能接收 Apple 远程推送。
# 官方发行 App 的私钥不能分发给家庭服务器；官方推送代理尚未提供。
# HOMEAI_APNS_KEY_FILE=state/secrets/AuthKey.p8
# HOMEAI_APNS_KEY_ID=你的10位KeyID
# HOMEAI_APNS_TEAM_ID=你的10位TeamID
# HOMEAI_APNS_TOPIC=你的AppBundleID
# 启动通知任务：PYTHONPATH=server .venv/bin/python scripts/run_notification_worker.py
